    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@scalar/nestjs-api-reference": "^1.2.11",
    "argon2": "^0.45.1",
    "axios": "^1.18.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.3",
    "luxon": "^3.7.2",
    "mongodb": "^7.5.0",
    "nestjs-pino": "^4.6.1",
    "openid-client": "^6.8.4",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "pgvector": "^0.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.1",
    "wkx": "^0.5.0"
  },
  "devDependencies": {
    "@asyncapi/cli": "^6.0.2",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@mikro-orm/cli": "^7.1.7",
    "@mikro-orm/entity-generator": "^7.1.7",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@redocly/cli": "^2.41.2",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/luxon": "^3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/passport": "^0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8",
    "@types/supertest": "^7.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "js-yaml": "^5.2.2",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "maxWorkers": "50%",
    "testRegex": ".*\\.spec\\.ts$",
    "testTimeout": 15000,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "<rootDir>/../test/tsconfig.integration.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "modules/iam/**/*.(t|j)s",
      "modules/common/**/*.(t|j)s",
      "modules/terminology/**/*.(t|j)s",
      "common/**/*.(t|j)s",
      "!**/entities/**",
      "!**/*.module.ts",
      "!**/index.ts",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ]
  }
}
