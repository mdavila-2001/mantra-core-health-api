    "start:worker:pharmacy_inventory": "node dist/src/worker-pharmacy_inventory",
    "start:worker:pharmacy_inventory:dev": "nest start --watch --entryFile worker-pharmacy_inventory",
    "start:worker:promotions": "node dist/src/worker-promotions",
    "start:worker:promotions:dev": "nest start --watch --entryFile worker-promotions",
    "start:worker:qa_lab": "node dist/src/worker-qa_lab",
    "start:worker:qa_lab:dev": "nest start --watch --entryFile worker-qa_lab",
