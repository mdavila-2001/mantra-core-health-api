  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "maxWorkers": 4,
    "workerIdleMemoryLimit": "768MB",
    "testRegex": ".*\\.spec\\.ts$",
    "testTimeout": 15000,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "collectCoverageFrom": [
      "modules/iam/**/*.(t|j)s",
      "modules/common/**/*.(t|j)s",
      "modules/terminology/**/*.(t|j)s",
      "common/**/*.(t|j)s",
      "!**/entities/**",
      "!**/*.module.ts",
      "!**/index.ts",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ]
  }
