{
  "name": "mantra-core-health-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --coverage",
    "test:integration": "cross-env ORM_SCHEMA_SYNC=off node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --config ./test/jest-integration.json",
    "test:integration:cov": "cross-env ORM_SCHEMA_SYNC=off node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --config ./test/jest-integration.json --coverage",
    "test:cov:merged": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --coverage && yarn test:integration:cov && node tools/coverage/merge-coverage.mjs",
    "smoke": "cross-env ORM_SCHEMA_SYNC=off node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --config ./test/jest-smoke.json",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest-cli/bin/jest.js --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "orm": "mikro-orm",
    "orm:gen": "mikro-orm generate-entities --config ./src/orm/config/orm.generator.config.ts --save",
    "orm:catalog": "node tools/catalog/generate-catalog.mjs",
    "orm:entities:missing": "node tools/catalog/generate-missing-entities.mjs",
    "orm:audit": "node tools/catalog/audit-fidelity.mjs graphify-out/fidelity-audit.json",
    "orm:schema:dump": "ORM_SCHEMA_SYNC=dry-run node dist/main"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@casl/ability": "^7.0.1",
    "@mikro-orm/core": "^7.1.7",
    "@mikro-orm/decorators": "^7.1.7",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.1.7",
    "@mikro-orm/reflection": "^7.1.7",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@opensearch-project/opensearch": "^3.6.0",
    "argon2": "^0.45.1",
    "axios": "^1.18.1",
    "bullmq": "^5.80.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "joi": "^18.2.3",
    "luxon": "^3.7.2",
    "mongodb": "^7.5.0",
    "nestjs-pino": "^4.6.1",
    "openid-client": "^6.8.4",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "pgvector": "^0.3.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.1",
    "wkx": "^0.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@mikro-orm/cli": "^7.1.7",
    "@mikro-orm/entity-generator": "^7.1.7",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/add": "^2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3",
    "@types/node": "^24.0.0",
    "@types/passport": "^0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8",
    "@types/supertest": "^7.0.0",
    "add": "^2.0.9",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "yarn": "^1.22.22"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "<rootDir>/../test/tsconfig.integration.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "modules/iam/**/*.(t|j)s",
      "modules/common/**/*.(t|j)s",
      "modules/terminology/**/*.(t|j)s",
      "common/**/*.(t|j)s",
      "!**/entities/**",
      "!**/*.module.ts",
      "!**/index.ts",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ]
  }
}
