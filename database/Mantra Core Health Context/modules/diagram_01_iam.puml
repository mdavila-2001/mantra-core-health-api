}
entity security_events <<LOG>> {
  * id : uuid <<PK>>
  --
    user_id : uuid <<FK>>
  * event_type_concept_id : uuid <<FK>>
  * outcome_concept_id : uuid <<FK>>
    ip : inet
    detail_json : jsonb
  * recorded_at : timestamptz
