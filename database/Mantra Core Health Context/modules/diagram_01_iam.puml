entity user_global_roles {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * role_concept_id : uuid <<FK>>
  * state_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
