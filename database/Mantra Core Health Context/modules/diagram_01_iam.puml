@startuml SALUD_Module_01_iam
title Module 01 — Identity & Access — User Accounts and Security\n(schema: iam)
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
hide circle

' ------------------------------------------------------------------------------
' SOURCE CONSOLIDATED: diagram_01_iam.puml
' ------------------------------------------------------------------------------
note as BIZ_diagram_01_iam
  BUSINESS PURPOSE
  Manages login accounts, credentials, MFA, devices and sessions. A user
  record is an authenticating account, not a person, patient or practitioner.
  Human identity and role profiles are modeled separately in Module 05 and
  linked optionally so patients and external professionals can exist without
  portal credentials.
end note

entity users <<ACCOUNT>> {
  * id : uuid <<PK>>
  --
  * status_concept_id : uuid <<FK>>
  * display_name : varchar
    preferred_language_concept_id : uuid <<FK>>
    time_zone : varchar
    residence_country_concept_id : uuid <<FK>>
    data_residency_region_concept_id : uuid <<FK>>
    email_verified : boolean
    phone_verified : boolean
    mfa_status_concept_id : uuid <<FK>>
    legal_basis_concept_id : uuid <<FK>>
    privacy_accepted_at : timestamptz
    privacy_policy_version : varchar
    anonymized_at : timestamptz
    last_login_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity authentication_credentials {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * method_concept_id : uuid <<FK>>
    external_subject : varchar
    secret_hash : varchar
    hash_algorithm_concept_id : uuid <<FK>>
    public_key : text
    identity_provider : varchar
  * state_concept_id : uuid <<FK>>
    last_used_at : timestamptz
    expires_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity mfa_factors {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * factor_type_concept_id : uuid <<FK>>
    label : varchar
    secret_encrypted : text
  * state_concept_id : uuid <<FK>>
    verified_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity devices {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
    device_fingerprint : varchar <<UK>>
    platform_concept_id : uuid <<FK>>
    name : varchar
    push_token_encrypted : text
    trusted : boolean
    last_seen_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity sessions {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
    device_id : uuid <<FK>>
  * token_id : varchar <<UK>>
    ip : inet
    geo_location : varchar
  * state_concept_id : uuid <<FK>>
  * expires_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity refresh_tokens {
  * id : uuid <<PK>>
  --
  * session_id : uuid <<FK>>
  * token_hash : varchar <<UK>>
  * state_concept_id : uuid <<FK>>
    replaced_by_id : uuid <<FK>>
  * expires_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
