# =========================================================================
# Mantra Core Technologies · ALOVIDA — variables del despliegue en Coolify
# -------------------------------------------------------------------------
# Este archivo NO se copia a un `.env` en el servidor. En Coolify las
# variables se pegan en la pestaña «Environment Variables» del recurso; el
# `docker-compose.coolify.yml` las lee de ahí para sustituir cada `${…}`.
#
# El compose de despliegue enumera el entorno de los contenedores de forma
# explícita: una variable que no figure en su bloque `x-app-env` NO existe
# dentro del contenedor por más que esté declarada aquí o en Coolify.
#
# Lo marcado OBLIGATORIA no tiene valor por defecto: sin ella el arranque
# falla, y falla temprano y con nombre, que es lo que se quiere.
# =========================================================================

# ─── Base de datos relacional ─── OBLIGATORIAS ────────────────────────────
POSTGRES_DB=alovida_health
POSTGRES_USER=alovida
# OBLIGATORIA. Generar: openssl rand -base64 24
POSTGRES_PASSWORD=

# Acceso de los testers de datos a Postgres (única base que se publica en el
# host). Por defecto queda atada al loopback del servidor (IC-02): se entra por
# túnel SSH (`ssh -L 5432:localhost:5432 usuario@servidor`). El rol lector se
# crea con `scripts/postgres/provision-reader-role.sql`; el rol `alovida` de
# arriba NO se reparte. Ver docs/operations/coolify.md § 7.
#
# Abrirlo a internet (`POSTGRES_PUBLIC_BIND=0.0.0.0`) sólo con TLS de servidor
# montado, `hostssl` exigido en `pg_hba.conf` y el firewall limitado a las IP de
# los testers: esta imagen no trae TLS y, sin él, filas y credenciales viajan en
# claro.
POSTGRES_PUBLIC_BIND=127.0.0.1
POSTGRES_PUBLIC_PORT=5432

# Cifrado de la conexión a PostgreSQL. Se deja vacío (equivale a `false`) para el
# despliegue de referencia, donde la base es un contenedor del propio stack y el
# tráfico no sale de la red interna. Ponerlo en `true` es OBLIGATORIO contra un
# PostgreSQL gestionado —Neon, RDS, Supabase—: esos rechazan el arranque de la
# conexión en claro, y el síntoma es un `connection terminated unexpectedly` que
# no menciona TLS por ningún lado.
DB_SSL=

# ─── Mongo (almacén documental, módulo 55) ────────────────────────────────
MONGO_DB=alovida_document_store

# ─── MinIO (objetos: audio, derivados de archivos) ─── OBLIGATORIAS ───────
# El bucket lo crea el one-shot `minio-init`; estas credenciales son también
# las del propio MinIO (`MINIO_ROOT_USER` / `MINIO_ROOT_PASSWORD`).
MINIO_ACCESS_KEY=
# OBLIGATORIA. Generar: openssl rand -base64 24
MINIO_SECRET_KEY=
MINIO_BUCKET=alovida-files

# ─── Los CINCO secretos que exige NODE_ENV=production ─── OBLIGATORIAS ────
# Piden 32+ caracteres y rechazan los valores de desarrollo. Generar cada uno
# por separado (nunca reutilizar el mismo entre variables):
#
#   openssl rand -hex 32
#
JWT_SECRET=
MFA_ENCRYPTION_KEY=
WEBHOOK_SIGNING_KEY=
DOWNLOAD_URL_SECRET=
# La quinta es la que nadie ve venir: se exige aunque la síntesis de voz esté
# apagada, porque quien la lee es el cifrador que se instancia junto con el
# módulo de audio, no el proveedor de voz. Sin ella el contenedor muere con
# «AUDIO_TTS_DATA_KEY (>=32 caracteres) es obligatoria en producción».
AUDIO_TTS_DATA_KEY=

# ─── Primer administrador (arranque en frío) ──────────────────────────────
# Sin una cuenta con SECURITY_ADMIN no hay forma de crear usuarios por API:
# `POST /iam/users` exige ese rol. El seed se NIEGA en producción salvo que
# `BOOTSTRAP_ADMIN_ALLOW_PRODUCTION` sea `true` explícito.
#
# Poner las tres para el primer despliegue; una vez que el administrador
# existe, volver `BOOTSTRAP_ADMIN_ALLOW_PRODUCTION` a `false` y BORRAR la
# contraseña de Coolify — queda guardada en claro en la configuración del
# recurso mientras siga ahí.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ALLOW_PRODUCTION=false

# Cuentas de demostración de socios comerciales (farmacia, laboratorio,
# imagen, aseguradora). Dejar apagadas en un servidor real: son cuatro
# credenciales conocidas contra datos de pacientes.
SEED_DEMO_PASSWORD=
SEED_DEMO_ALLOW_PRODUCTION=false

# ─── Red y proxy ──────────────────────────────────────────────────────────
# Nombre de la red Docker compartida con el stack del frontend. Crearla UNA
# VEZ en el servidor antes del primer despliegue:
#
#   docker network create alovida
#
ALOVIDA_NETWORK=alovida

# Saltos de proxy de confianza para `req.ip`. Con el frontend delante son 2
# (Traefik de Coolify → nginx del frontend → API). Si algún día la API se
# publica con dominio propio y sin nginx en medio, es 1.
TRUST_PROXY_HOPS=2

# Orígenes del frontend cuando NO comparte dominio con la API (p. ej. el
# front en Hostinger y la API con dominio propio en Coolify). Separados por
# coma, exactos, sin ruta ni `*`. Vacío = CORS denegado (mismo origen).
# En ese caso la API se llama directo por Traefik: TRUST_PROXY_HOPS=1.
CORS_ALLOWED_ORIGINS=

# La cookie de refresco solo viaja por HTTPS. Coolify termina TLS, así que
# esto es `true` en cuanto el dominio tenga certificado.
AUTH_REFRESH_COOKIE_ENABLED=false
AUTH_REFRESH_COOKIE_SECURE=true

# ─── Identidad del artefacto ──────────────────────────────────────────────
# Coolify expone el commit desplegado como `SOURCE_COMMIT`; el compose lo
# pasa al build para que `/health` pueda decir qué código está corriendo.
# No hace falta declararlo a mano.
# SOURCE_COMMIT=
APP_VERSION=

# ─── Correo real (Gmail API) ──────────────────────────────────────────────
# Las CUATRO o ninguna: `GoogleProviderWiringService.isConfigured()` exige el
# juego completo y, si falta una, se queda con el adaptador que no envía nada
# y NO emite ningún error. El remitente tiene que ser la misma cuenta que dio
# el consentimiento. Se obtienen con:
#   yarn google:oauth:get-refresh-token
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=

# ─── Opcionales ───────────────────────────────────────────────────────────
# Seguridad a nivel de fila (HZ-05). Con el rol dueño (POSTGRES_USER, superusuario)
# RLS no se aplica. Para que la API conecte con `mantra_app` (sin BYPASSRLS):
# definir DB_APP_USER=mantra_app, DB_APP_PASSWORD (openssl rand -base64 24) y
# RLS_ENFORCE=true, las tres juntas. `postgres-init` le habilita LOGIN. En
# producción la API NO arranca con un rol que ignore RLS; la única excepción es
# transitoria: DB_ALLOW_PRIVILEGED_RUNTIME_ROLE=true. Ver docs/operations/coolify.md.
RLS_ENFORCE=false
DB_APP_USER=
DB_APP_PASSWORD=
DB_ALLOW_PRIVILEGED_RUNTIME_ROLE=false

# Medición de peticiones HTTP (panel de tráfico del portal de observabilidad).
# La API cuenta por minuto y por PLANTILLA de ruta (nunca la URL real, el cuerpo
# ni el usuario) y lo vuelca a `time_series.service_sli_series`. El código la
# deja APAGADA por defecto y sin esta variable el panel de tráfico sale vacío en
# producción. Encenderla escribe en la base cada FLUSH_SECONDS (entero 10-3600).
# Un valor inválido hace fallar el arranque de la API.
OBSERVABILITY_HTTP_SLI_ENABLED=true
OBSERVABILITY_HTTP_SLI_FLUSH_SECONDS=60

# Trazas distribuidas. Requiere un colector alcanzable desde la red del stack.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Síntesis de voz. Encenderla cuesta dinero por petición.
AUDIO_TTS_ENABLED=false
AUDIO_TTS_PROVIDER=disabled
ELEVENLABS_API_KEY=

# Almacenamiento de archivos: `local` (volumen del contenedor de la API) o
# `s3`. Con más de una réplica de la API tiene que ser `s3`: un volumen local
# no se comparte entre contenedores y las subidas de una réplica serían
# invisibles para la otra.
FILE_STORAGE_ADAPTER=local
