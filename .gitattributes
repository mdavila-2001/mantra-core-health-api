# =========================================================================
# Normalización de fin de línea — portabilidad Mac / Windows / Linux.
# Sin esto, un checkout en Windows puede traer CRLF y romper los scripts .sh
# que corren dentro de contenedores Linux (error tipo "bash\r: not found").
# =========================================================================

# Por defecto: Git normaliza a LF en el repo y respeta el SO al hacer checkout.
* text=auto eol=lf

# Scripts de shell y archivos que SIEMPRE deben ser LF (corren en Linux/containers).
*.sh        text eol=lf
*.bash      text eol=lf
.env        text eol=lf
.env.*      text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Scripts específicos de Windows: mantener CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binarios: nunca tocar el contenido.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.gz        binary

# graphify — versionar el grafo con merge dedicado (regla previa, conservada).
graphify-out/graph.json merge=graphify
