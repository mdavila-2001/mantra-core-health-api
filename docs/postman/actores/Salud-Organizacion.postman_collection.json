        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"SEDE-{{$timestamp}}\",\n  \"name\": \"Sede Central\",\n  \"branchType\": \"CLINIC\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Lo hace el owner con su propio token: su poder viene de la membresía OWNER, no de un rol global de plataforma."
      },
      "response": [],
