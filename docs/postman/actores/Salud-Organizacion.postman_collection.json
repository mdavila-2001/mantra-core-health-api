        "description": "Se usa el autoregistro público de profesionales para no depender de un administrador: el owner no puede crear cuentas IAM, pero sí incorporar a quien ya tiene una."
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('staffEmail', 'staff-' + Date.now() + '@example.test');"
