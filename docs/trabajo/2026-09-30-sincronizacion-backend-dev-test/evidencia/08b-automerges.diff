+      # hipótesis, no una medición — el token de la API de Coolify no tiene
+      # permiso para leer los logs del contenedor, así que no se pudo confirmar
+      # que el reinicio fuera un OOM. Acotar el montón es correcto de todos
+      # modos: hoy no hay ningún límite.
+      NODE_OPTIONS: '--max-old-space-size=1024'
