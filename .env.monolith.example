# =========================================================================
# AloVida Health Ecosystem — Configuración Monolito Esbelto (.env)
# =========================================================================

# --- Entorno de Ejecución ---
NODE_ENV=production
PORT=3000

# --- Base de Datos PostgreSQL 16 con PostGIS ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=alovida_health
DB_SSL=false

# Usuario Propietario / Migraciones (DDL / seeds):
DB_USER=alovida_admin
DB_PASSWORD=CAMBIAR_PASSWORD_ADMIN_PROD_32_CHARS_MIN

# Usuario Aplicación Runtime (DML sin bypassrls para aislar clínicas):
DB_APP_USER=alovida_app
DB_APP_PASSWORD=CAMBIAR_PASSWORD_APP_PROD_32_CHARS_MIN

# --- Seguridad y Aislamiento Clínico Multi-Tenancy ---
# RLS_ENFORCE=true garantiza que ninguna consulta escape del contexto del tenant.
RLS_ENFORCE=true
DEV_VERIFICATION_BYPASS=false

# --- Autenticación y Criptografía (JWT / Cookies) ---
# En producción, JWT_SECRET debe tener al menos 32 caracteres y ser criptográficamente aleatorio.
JWT_SECRET=CAMBIAR_CLAVE_JWT_SUPER_SECRETA_PROD_ALMENOS_32_CARACTERES
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_REFRESH_COOKIE_ENABLED=true
AUTH_REFRESH_COOKIE_NAME=alovida_refresh
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=strict

# --- Redis 7 (Caché y Colas de Tareas Asíncronas BullMQ) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Almacenamiento de Archivos (MinIO / AWS S3 / Cloudflare R2) ---
FILE_STORAGE_ADAPTER=s3
FILE_STORAGE_MAX_SIZE_BYTES=10485760
FILE_STORAGE_S3_ENDPOINT=http://minio:9000
FILE_STORAGE_S3_FORCE_PATH_STYLE=true
FILE_STORAGE_S3_BUCKET=alovida-files
FILE_STORAGE_S3_REGION=us-east-1
MINIO_ROOT_USER=alovida_minio
MINIO_ROOT_PASSWORD=CAMBIAR_PASSWORD_MINIO_PROD_32_CHARS

# --- Control de Tasa (Throttling / Anti DoS) ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

# --- Facturación Fiscal SIAT (Servicio de Impuestos Nacionales de Bolivia) ---
# Modo simulador autorizado temporalmente mientras se completa homologación.
# En el nuevo monolito, el NIT se lee dinámicamente del consultorio/médico emisor.
SIAT_MODE=simulated
SIAT_BASE_URL=https://pilotosiat.impuestos.gob.bo
SIAT_TIMEOUT_MS=15000

# --- Observabilidad y Logs ---
LOG_LEVEL=info
OBSERVABILITY_HTTP_SLI_ENABLED=true
OBSERVABILITY_HTTP_SLI_FLUSH_SECONDS=60
