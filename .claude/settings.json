{
  "permissions": {
    "allow": [
      "Bash(graphify:*)",
      "Bash(/Library/Frameworks/Python.framework/Versions/3.14/bin/graphify:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn build:*)",
      "Bash(yarn test:*)",
      "Bash(yarn format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Library/Frameworks/Python.framework/Versions/3.14/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Library/Frameworks/Python.framework/Versions/3.14/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  }
}
