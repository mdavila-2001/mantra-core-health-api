# REDESA Ecosystem — plantilla de entorno (copiar a .env). Valores de desarrollo;
# los puertos coinciden con los expuestos por docker-compose.yml. No poner secretos
# de producción acá: en prod las credenciales vienen de un secret manager.

PORT=3000
NODE_ENV=development

# --- Capa relacional PostgreSQL (obligatoria para el ORM) -------------------
# Puerto 5433 = expuesto por el contenedor redesa-postgres (5433:5432).
DB_HOST=localhost
DB_PORT=5433
DB_USER=salud
DB_PASSWORD=salud_pass_dev
DB_NAME=salud

# Logs SQL de MikroORM (true | false)
MIKRO_ORM_DEBUG=false

# --- Stores especializados (fuera del ORM: outbox + workers) ----------------
# Aún no consumidos por el backend; documentados para completar el contrato de env.
MONGODB_URI=mongodb://localhost:27018/salud_document_store

REDIS_HOST=localhost
REDIS_PORT=6380

OPENSEARCH_NODE=http://localhost:9201

MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=redesa_admin
MINIO_SECRET_KEY=redesa_secret_key
MINIO_BUCKET=redesa-health-files
