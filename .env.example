# =========================================================================
# Mantra Core Technologies · REDESA Health Ecosystem
# Plantilla de entorno — copiar a .env y ajustar. Valores de desarrollo.
# No poner secretos de producción acá (en prod: secret manager).
# Los puertos coinciden con los que expone docker-compose.yml.
# Las rutas del esquema (database/SQL, database/NoSQL) están FIJAS en el
# compose, integradas al repo: no se configuran por env.
# =========================================================================
PORT=3000
NODE_ENV=development

# --- SQL Relacional + TimescaleDB + pgvector (puerto expuesto 5433) ----------
# La app se conecta con DB_*; el contenedor Postgres se siembra con POSTGRES_*.
# Deben tener los MISMOS valores o la app no conectará.
DB_HOST=localhost
DB_PORT=5433
DB_USER=mantra
DB_PASSWORD=changeme_dev
DB_NAME=mantra_redesa_health

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=mantra
POSTGRES_PASSWORD=changeme_dev
POSTGRES_DB=mantra_redesa_health

# --- Mongo Document Store (puerto expuesto 27018) ----------------------------
# MONGO_DB debe coincidir con la base de MONGODB_URI.
MONGODB_URI=mongodb://localhost:27018/mantra_redesa_health_document_store
MONGO_DB=mantra_redesa_health_document_store

# --- Redis Runtime (puerto expuesto 6380) ------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380

# --- OpenSearch Search Platform (puerto expuesto 9201) -----------------------
OPENSEARCH_NODE=http://localhost:9201

# --- MinIO Object Storage (puerto expuesto 9002 API / 9003 consola) ----------
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=mantra
MINIO_SECRET_KEY=changeme_dev
MINIO_BUCKET=mantra-redesa-health-files

# --- Observabilidad del ORM --------------------------------------------------
MIKRO_ORM_DEBUG=false

# --- Materialización del esquema ---------------------------------------------
# off | dry-run | safe (el default del código es 'safe').
#
# DEBE quedar en 'off'. Con 'safe' la aplicación aplica DDL aditivo por sí sola al
# arrancar, es decir crea en Postgres tablas y columnas que `SQL/` no declara — la
# dirección de cambio prohibida por el protocolo de 4 capas
# (.puml -> SQL/ -> BD -> ORM). Así fue como llegaron a la base cuatro tablas que
# el modelo canónico no conocía.
#
# Para auditar deriva usá 'dry-run': calcula y loguea el DDL sin ejecutarlo, y sí
# corre el chequeo de fidelidad. Ojo: con 'off' el chequeo de fidelidad NO corre.
ORM_SCHEMA_SYNC=off
ORM_VERIFY_FIDELITY=true

# Autenticación (JWT). En producción JWT_SECRET es obligatorio (>=32) y no puede ser el default.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
ACCOUNT_LOCK_THRESHOLD=5

# Cifrado del secreto TOTP de MFA (AES-256-GCM). Obligatorio en producción.
MFA_ENCRYPTION_KEY=dev-only-mfa-key-change-me

# Firma de webhooks (entrantes y salientes). Obligatorio en producción.
WEBHOOK_SIGNING_KEY=dev-only-insecure-webhook-key-change-me

# Firma de las URL de descarga de archivos clínicos. Obligatorio en producción:
# con el valor de desarrollo, que es público, se puede forjar una URL de descarga
# para cualquier archivo.
DOWNLOAD_URL_SECRET=redesa-dev-download-secret

# Almacenamiento de archivos subidos por multipart (POST /common/files/upload).
# El adaptador `local` escribe en disco, direccionando por SHA-256 del contenido;
# un futuro adaptador S3 se selecciona aquí sin tocar el código que sube.
FILE_STORAGE_ADAPTER=local
FILE_STORAGE_LOCAL_DIR=./storage/uploads
FILE_STORAGE_MAX_SIZE_BYTES=10485760

# Aislamiento por tenant (RLS). RLS_ENFORCE=true hace que el interceptor fije
# app.current_tenant_id por request (transacción por petición). Para que las
# políticas RLS se apliquen, la app debe conectarse con un rol SIN bypassrls:
# definir DB_APP_USER/DB_APP_PASSWORD (p. ej. mantra_app) y ORM_SCHEMA_SYNC=off.
# El rol propietario (DB_USER) se reserva para migraciones/DDL/seed.
RLS_ENFORCE=false
# DB_APP_USER=mantra_app
# DB_APP_PASSWORD=

# --- Rutas de datos: lectura y escritura -------------------------------------
# TODAS estas variables son opcionales. Sin ninguna de ellas, lectura y
# escritura resuelven a la misma conexión de arriba, se detectan como
# equivalentes y comparten un único pool: el comportamiento de siempre.
# Ver docs/data/read-write-routing.md.
#
# Nombres lógicos con los que el enrutado resuelve cada ruta.
# DATA_READ_CONNECTION_NAME=postgres-read
# DATA_WRITE_CONNECTION_NAME=postgres-write
# DATA_ADMIN_CONNECTION_NAME=postgres-admin
#
# Separar SOLO la credencial (mismo servidor, rol de solo lectura). Es el modo
# recomendado en desarrollo: hace que las lecturas se ejecuten con un rol que
# no puede escribir, así que un bug que intente escribir por la ruta de lectura
# falla con 42501 en vez de pasar desapercibido.
# DB_READ_USER=mantra_reader
# DB_READ_PASSWORD=
#
# O separar el servidor entero (réplica de lectura). Tiene precedencia sobre
# DB_READ_*. La contraseña va percent-encoded si lleva @ o /.
# POSTGRES_READ_URL=postgresql://mantra_reader:clave@replica:5432/mantra_redesa_health
# POSTGRES_WRITE_URL=postgresql://mantra_writer:clave@primary:5432/mantra_redesa_health
#
# Conexión administrativa: DDL, migraciones y aprovisionamiento. NUNCA se
# inyecta en un caso de uso, y el arranque aborta si el enrutado la referencia.
# POSTGRES_ADMIN_URL=postgresql://mantra:clave@localhost:5434/mantra_redesa_health
#
# Pool propio de la ruta de lectura. Sin esto hereda DB_POOL_MIN/MAX.
# DB_READ_POOL_MIN=2
# DB_READ_POOL_MAX=10
#
# Qué hacer si la conexión de lectura falla:
#   fail-fast           el fallo se propaga (por defecto).
#   fallback-to-primary reintenta en la primaria y lo registra con motivo.
# El default es fail-fast por dos razones. El desvío cambia la consistencia sin
# que nadie lo haya pedido y, cuando la separación es por rol, haría que las
# lecturas se ejecutaran con la credencial de ESCRITURA: una escalada de
# privilegios silenciosa. Quien quiera el desvío debe pedirlo.
# DATA_READ_FALLBACK=fail-fast
#
# Proveedor del despliegue (local, docker, neon, supabase, rds, cloudsql...).
# No cambia la semántica del motor; aparece en /health/data-sources para que un
# operador sepa contra qué habla el proceso.
# DATA_SOURCE_PROVIDER=local

# --- Migración progresiva a puertos (§47) ------------------------------------
# Lista separada por comas de los módulos que ya operan por el enrutado nuevo.
# Vacío = ninguno migrado, que es el valor seguro. Los módulos ausentes usan el
# `EntityManager` de siempre, así que sacar uno de la lista es la vuelta atrás
# sin desplegar código.
# PERSISTENCE_PORTS_MODULES=scheduling

# --- Roles de aplicación PostgreSQL (yarn db:provision:dev) ------------------
# Aprovisiona de forma idempotente un rol escritor (DML) y uno lector (SELECT),
# ambos NOSUPERUSER y NOBYPASSRLS, y VERIFICA el resultado ejecutando
# operaciones reales con cada uno. Se niega a correr con NODE_ENV=production:
# allí los roles se crean por IaC o por un proceso controlado.
# POSTGRES_WRITER_ROLE=mantra_writer
# POSTGRES_READER_ROLE=mantra_reader
# POSTGRES_WRITER_PASSWORD=
# POSTGRES_READER_PASSWORD=
# Propietario de los objetos: determina a qué rol se aplican los privilegios por
# defecto de las tablas futuras. Por defecto, DB_USER.
# POSTGRES_OWNER_ROLE=mantra
# Esquemas gestionados. Sin esto se descubren todos los de negocio, excluyendo
# los del motor y los de TimescaleDB, cuyos privilegios gestiona la extensión.
# POSTGRES_MANAGED_SCHEMAS=iam,scheduling,billing

# Rate limiting: RATE_LIMIT_DISABLED=true solo en pruebas (mismo IP, muchas peticiones).
# RATE_LIMIT_DISABLED=false

# --- Primer administrador (arranque en frío) ---------------------------------
# `POST /iam/users` exige rol SECURITY_ADMIN, y una instalación nueva no tiene
# ninguno: sin esto sólo se pueden ejercer los endpoints públicos y no hay forma
# de crear el primer administrador por API.
#
# Definir AMBAS variables hace que el arranque siembre esa cuenta con rol
# SECURITY_ADMIN + SUPERADMIN global y membresía en el tenant por defecto. Es
# idempotente: si la cuenta ya existe, completa lo que falte y no toca nada más.
# Sin ellas el arranque no crea ninguna cuenta.
#
# La contraseña viaja en una variable de entorno y queda en el historial del
# despliegue, así que en NODE_ENV=production el seed se NIEGA salvo que se lo
# autorice explícitamente con BOOTSTRAP_ADMIN_ALLOW_PRODUCTION=true.
# BOOTSTRAP_ADMIN_EMAIL=admin@redesa.test
# BOOTSTRAP_ADMIN_PASSWORD=S3cret-passw0rd
# BOOTSTRAP_ADMIN_ALLOW_PRODUCTION=false

# --- Entrega del refresh token ------------------------------------------------
# Hoy el refresh token viaja en el CUERPO de login/refresh y el front lo guarda
# en localStorage: superficie de XSS aceptada de forma consciente y temporal.
#
# Con AUTH_REFRESH_COOKIE_ENABLED=true el token se entrega como cookie httpOnly
# (`redesa_refresh`, SameSite=Strict, Path acotado al endpoint de refresco) y
# DEJA de venir en el cuerpo. Eso cambia el contrato del cliente, así que
# encenderlo es una decisión coordinada con el front y exige además declarar la
# allowlist de CORS con `credentials: true`. Ver `src/common/auth/README.md`.
# AUTH_REFRESH_COOKIE_ENABLED=false
#
# `Secure` sigue a NODE_ENV salvo que se declare aquí. Sólo hace falta tocarlo
# en pruebas o detrás de un proxy que termina TLS.
# AUTH_REFRESH_COOKIE_SECURE=

# --- Trazas distribuidas (OpenTelemetry -> OTLP -> Jaeger) -------------------
# Ver `docs/observability/README.md`. Levantar Jaeger local: `yarn jaeger:up`.
#
# Apagado por defecto: activarlo abre conexiones salientes desde los 21 procesos
# (API + 20 workers), y eso debe ser una decisión explícita.
OTEL_ENABLED=false

# `service.name` se DERIVA del entrypoint en ejecución (`dist/src/main.js` ->
# redesa-api; `dist/src/worker-messaging.js` -> redesa-worker-messaging), así que
# normalmente no hace falta declararlo. Definirlo aquí lo fijaría para TODOS los
# procesos, incluidos los 20 workers: dejar vacío salvo que se sepa lo que se hace.
# OTEL_SERVICE_NAME=
OTEL_SERVICE_NAMESPACE=redesa
# Vacío = se toma de `npm_package_version`, o `unknown` fuera de un script de yarn.
OTEL_SERVICE_VERSION=
# Vacío = se toma de NODE_ENV.
OTEL_DEPLOYMENT_ENVIRONMENT=

# Único protocolo soportado: es el exportador instalado (`exporter-trace-otlp-proto`).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Esta variable la usan los procesos que corren FUERA de Docker
# (`yarn start:dev`, `yarn start:worker:*:dev`), que alcanzan Jaeger por el
# puerto publicado en 127.0.0.1.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Los contenedores de `docker-compose.yml` usan ESTA otra, porque dentro de la
# red de Docker `localhost` es el propio contenedor y no Jaeger. Son dos
# variables distintas justamente para poder tener ambos modos a la vez sin
# editar el `.env` cada vez que se cambia de uno a otro.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT_DOCKER=http://jaeger:4318/v1/traces
OTEL_EXPORT_TIMEOUT_MS=10000

# Muestreo basado en el padre: respeta la decisión del servicio aguas arriba, de
# modo que una traza que cruza worker -> API no queda partida por la mitad.
# Ratios orientativos: desarrollo 1.0, staging 0.25-1.0, producción 0.05-0.20.
# Ver `docs/observability/README.md` (muestreo) antes de bajarlo en producción.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

OTEL_PROPAGATORS=tracecontext,baggage
# Diagnóstico interno del SDK. NONE|ERROR|WARN|INFO|DEBUG|VERBOSE.
OTEL_DIAG_LOG_LEVEL=ERROR
# Cabecera `x-trace-id` en las respuestas HTTP: es el identificador que un
# usuario entrega a soporte para localizar su traza.
OTEL_TRACE_RESPONSE_HEADER=true

# Puertos publicados por `docker-compose.jaeger.yml` (solo en 127.0.0.1).
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318
JAEGER_OTLP_GRPC_PORT=4317

# --- Workers asíncronos (20 procesos separados, uno por dominio — ver
# `PLAN-CORRECCION-WORKERS-2026-07-28.md`. `yarn start:worker:<dominio>:dev`,
# p. ej. `yarn start:worker:messaging:dev`) --------------------------------
# URL interna de la API que consumen los workers como usuario SYSTEM autenticado.
WORKER_API_BASE_URL=http://127.0.0.1:3000
WORKER_HTTP_TIMEOUT_MS=30000

# --- Resiliencia de los workers -------------------------------------------
# Sonda HTTP de cada worker: GET /health (liveness), /readiness y /status.
# Es lo que permite a Docker/Kubernetes distinguir un worker sano de uno con el
# tick colgado — sin ella sólo se puede comprobar que el PID existe, y un
# worker zombi pasa esa comprobación indefinidamente. `0` la deshabilita.
# Fuera de Docker, si el puerto está ocupado el worker arranca sin sonda y lo
# avisa en el log; nunca aborta por eso.
WORKER_HEALTH_PORT=9100
# Plazo de un tick programado. No es el plazo de una llamada
# (WORKER_HTTP_TIMEOUT_MS) sino el techo tras el cual la ejecución se aborta.
# Generoso porque los ticks van desde subsegundo (relevo del outbox) hasta
# minutos (compresión de chunks de time_series).
WORKER_TICK_TIMEOUT_MS=300000
# Tiempo que un tick puede llevar en vuelo antes de que la liveness lo declare
# atascado y el orquestador reinicie el proceso. Por encima del plazo del tick
# a propósito: superarlo significa que ni el aborto surtió efecto.
WORKER_STUCK_TICK_MS=600000
# Espera máxima a que terminen los ticks en vuelo durante el apagado. Sin ella,
# un SIGTERM en mitad de un lote deja filas reclamadas por un worker que ya no
# existe y mensajes enviados que el sistema no sabe que envió.
WORKER_DRAIN_TIMEOUT_MS=20000
# Plazo total del apagado; al agotarse el proceso sale con código 1 dejando
# escrito qué seguía pendiente. Debe quedar POR DEBAJO del plazo de gracia del
# orquestador (10 s en `docker stop` por defecto; en docker-compose.yml se sube
# a 45 s con `stop_grace_period`), o quien fuerza la salida es un SIGKILL mudo.
WORKER_SHUTDOWN_TIMEOUT_MS=30000
# Intentos totales de una LECTURA a la API, incluido el primero. Las escrituras
# no se reintentan salvo que el job las declare idempotentes: un timeout no
# dice si el servidor ejecutó la operación, y reintentar a ciegas duplicaría
# envíos y cobros.
WORKER_HTTP_RETRY_ATTEMPTS=3
# Techo de llamadas simultáneas a la API por proceso worker (mamparo). Acota
# los descriptores de fichero cuando la API va lenta.
WORKER_HTTP_MAX_CONCURRENT=16

# Lista separada por comas. Vacía = no drenar colas de mensajes configurables.
MESSAGING_QUEUE_CODES=

# Umbral de compresión de chunks de time_series (12 series, automático).
TS_COMPRESSION_OLDER_THAN=7 days
# Ventana (horas) que se rematerializa en cada tick de rollups de time_series.
TS_ROLLUP_REFRESH_WINDOW_HOURS=2
# Retención de time_series: OPT-IN por tabla, vacía por defecto — drop_chunks
# borra datos sin vuelta atrás y cada serie tiene su propia política de
# cumplimiento. Formato: "tabla=intervalo,tabla2=intervalo2".
TS_RETENTION_POLICIES=

# Emulador standalone de proveedores externos (mensajería, borrado
# cross-store, embeddings) — proyecto independiente en `mock-provider-server/`,
# ver su README. Configurado por DEFECTO: si se deja vacía, cada worker cae
# al adapter que falla visible ("PROVIDER_NOT_CONFIGURED") en vez de fingir
# éxito contra un proveedor real inexistente.
MOCK_PROVIDER_BASE_URL=http://127.0.0.1:4100
# Sólo si levantaste mock-provider-server con MOCK_API_KEY configurada.
MOCK_PROVIDER_API_KEY=

# ATENCIÓN — verificación de identidad simulada.
# El emulador ACEPTA POR DEFECTO toda verificación: con la tasa de rechazo en 0,
# el documento de identidad de un paciente (IDA_CHECK_TYPE_IDENTITY_CARD) y la
# matrícula de un médico (IDA_CHECK_TYPE_MEDICAL_LICENSE) salen ambos ACCEPTED.
# Ningún registro civil ni colegio médico comprobó nada: el flujo se ejercita
# entero, pero la verificación es ficticia.
#
# Por eso los 20 workers ABORTAN el arranque si MOCK_PROVIDER_BASE_URL está
# configurada con NODE_ENV=production (ver `assertMockProviderNotInProduction`).
#
# Para probar el camino de RECHAZO, subir la tasa entre 0 y 1:
MOCK_IDENTITY_REJECTION_RATE=0
# Cuánto tarda la "autoridad" en resolver el veredicto (ms). Es lo que ejercita
# el bucle de espera del worker, que consulta hasta que deja de estar PENDING.
MOCK_IDENTITY_DELAY_MS=10000

# Proveedor REAL de envío de email (canal EMAIL de messaging) vía Gmail API,
# OAuth2 de cuenta normal (sin Workspace, sin delegación de dominio). Las 4
# deben estar presentes para que el worker de messaging use Gmail de verdad
# en vez del stub/mock — ver src/worker/google-email-client.service.ts y
# tools/google-oauth/get-refresh-token.mjs (script para obtener el
# GOOGLE_OAUTH_REFRESH_TOKEN con un consentimiento interactivo, una sola vez).
# Si ambos, mock y Google, están configurados a la vez, Google gana.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=

# ===========================================================================
# Síntesis de voz cacheada (`audio_tts`)
# ===========================================================================
# Dos procesos, dos secretos distintos, y ninguno puede hacer el trabajo del
# otro: la API cifra y contabiliza con AUDIO_TTS_DATA_KEY, y el worker gasta
# cuota con ELEVENLABS_API_KEY. Ver src/modules/audio_tts/README.md.
#
# APAGADO POR DEFECTO. Es un servicio de pago por llamada: se enciende a
# propósito, no por olvido. Con `disabled`, el resolutor sigue sirviendo de
# caché lo ya generado y degrada a FALLBACK/UNAVAILABLE — nunca falla.
AUDIO_TTS_ENABLED=false
# disabled | fake | elevenlabs. `fake` fabrica bytes con forma de audio para
# ejercitar el flujo sin credencial, y está PROHIBIDO en producción: un asset
# READY no se regenera nunca, así que dejaría el catálogo cacheado con audio
# que no suena.
AUDIO_TTS_PROVIDER=disabled
# Generar audio nuevo DURANTE una petición de usuario. Separado del
# interruptor maestro: se puede querer pre-generar el catálogo (`prewarm`) sin
# abrir la puerta a que cada onboarding gaste cuota.
AUDIO_TTS_ALLOW_RUNTIME_GENERATION=false
# En producción, sin esta confirmación explícita no se genera ni un audio:
# sintetizar una voz de marca bajo un plan que no lo permite es un problema
# contractual que ningún reintento arregla.
AUDIO_TTS_PROD_LICENSE_CONFIRMED=false

# Identidad del render. Cambiar cualquiera de estos valores produce audios
# NUEVOS (no reescribe los existentes) y deja los fallbacks anteriores sin
# usar: hay que volver a pre-generarlos o toda degradación dará UNAVAILABLE.
AUDIO_TTS_DEFAULT_LANGUAGE=es-419
AUDIO_TTS_DEFAULT_FORMAT=mp3_44100_128
AUDIO_TTS_SAMPLE_RATE=44100
AUDIO_TTS_VOICE_PROFILE=brand_es_latam_v1
AUDIO_TTS_VOICE_VERSION=1
AUDIO_TTS_MODEL=eleven_v3
AUDIO_TTS_GLOBAL_FALLBACK_TEMPLATE=onboarding.fallback.generic
AUDIO_TTS_MAX_TEXT_LENGTH=5000

# Presupuesto mensual en unidades facturables (caracteres). La reserva es
# ATÓMICA: se aparta cuota al autorizar, no al gastar, así que N peticiones
# concurrentes no pueden superar el límite.
AUDIO_TTS_MONTHLY_BUDGET_UNITS=10000
# Colchón que la generación runtime nunca toca.
AUDIO_TTS_SAFETY_RESERVE_UNITS=1000
# Generaciones por actor y día. 0 significa BLOQUEADO, no ilimitado: para
# quitar el techo hay que declararlo con la variable de abajo.
AUDIO_TTS_RUNTIME_GENERATIONS_PER_ACTOR_DAY=3
AUDIO_TTS_ACTOR_LIMIT_UNLIMITED=false

# Red y resiliencia del proveedor (solo las usa el worker). El ritmo se aplica
# POR PROCESO: con N réplicas, AUDIO_TTS_REPLICA_COUNT divide la cuota para no
# multiplicar en silencio el RPS real contra un servicio de pago.
AUDIO_TTS_REQUEST_TIMEOUT_MS=10000
AUDIO_TTS_MAX_RESPONSE_BYTES=10485760
AUDIO_TTS_MIN_RESPONSE_BYTES=256
# 0 a propósito: el reintento de verdad lo aporta el ciclo de vida del asset
# (attempts + lease), que sobrevive a una caída del proceso.
AUDIO_TTS_HTTP_MAX_RETRIES=0
AUDIO_TTS_RETRY_BASE_MS=500
AUDIO_TTS_MAX_CONCURRENCY=2
AUDIO_TTS_MAX_REQUESTS_PER_SECOND=2
AUDIO_TTS_REPLICA_COUNT=1
AUDIO_TTS_BULKHEAD_QUEUE_SIZE=16
AUDIO_TTS_BULKHEAD_WAIT_MS=15000
AUDIO_TTS_CB_FAILURE_THRESHOLD=5
AUDIO_TTS_CB_OPEN_MS=30000

# Cifrado del texto renderizado en reposo (puede contener el nombre de un
# paciente). Mínimo 32 caracteres en todos los entornos salvo `test`, y el
# valor de abajo está BLOQUEADO por validación: está publicado en el repo.
# Rotación: subir AUDIO_TTS_DATA_KEY_ID con la clave nueva y dejar la anterior
# en AUDIO_TTS_DATA_KEYS_PREVIOUS con formato id:secreto[,id:secreto].
AUDIO_TTS_DATA_KEY=dev-only-audio-data-key-change
AUDIO_TTS_DATA_KEY_ID=k1
AUDIO_TTS_DATA_KEYS_PREVIOUS=

# ElevenLabs: solo con AUDIO_TTS_PROVIDER=elevenlabs. Vacíos = usar
# AUDIO_TTS_MODEL / AUDIO_TTS_DEFAULT_FORMAT.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
ELEVENLABS_OUTPUT_FORMAT=

# Ciclo de vida de la generación. El lease DEBE superar
# AUDIO_TTS_REQUEST_TIMEOUT_MS o dos workers reclamarían el mismo asset y el
# audio se pagaría dos veces; la validación de entorno lo comprueba al arrancar.
AUDIO_GENERATION_LEASE_SECONDS=300
AUDIO_GENERATION_MAX_ATTEMPTS=4
AUDIO_GENERATION_BATCH_SIZE=2
AUDIO_GENERATION_INTERVAL_MS=5000
# Espera antes de volver a reclamar un asset que falló de forma transitoria.
# Sin ella, el tick siguiente quemaría otro intento contra un proveedor que
# aún está caído.
AUDIO_GENERATION_RETRY_DELAY_SECONDS=30
AUDIO_RECONCILE_INTERVAL_MS=300000
AUDIO_RECONCILE_STALE_SECONDS=900
AUDIO_RECONCILE_BATCH_SIZE=100
# Retención del contador diario por actor (contiene identificadores de personas).
AUDIO_RETENTION_ACTOR_DAILY_DAYS=90

# Almacenamiento del audio. La API y el worker deben ver el MISMO storage: el
# worker escribe los bytes y la API firma la URL de reproducción. `local` está
# bloqueado en producción salvo override explícito (el audio viviría en el
# disco del contenedor y cada despliegue borraría la caché entera).
AUDIO_STORAGE_DRIVER=local
AUDIO_LOCAL_STORAGE_PATH=./storage/audio-assets
AUDIO_ALLOW_LOCAL_STORAGE_IN_PROD=false
AUDIO_SIGNED_URL_TTL_SECONDS=900
AUDIO_S3_BUCKET=
AUDIO_S3_REGION=auto
AUDIO_S3_ENDPOINT=
AUDIO_S3_ACCESS_KEY_ID=
AUDIO_S3_SECRET_ACCESS_KEY=
