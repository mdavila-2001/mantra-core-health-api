# REDESA Ecosystem — plantilla de entorno (copiar a .env). Valores de desarrollo;
# los puertos coinciden con los expuestos por docker-compose.yml. No poner secretos
# de producción acá: en prod las credenciales vienen de un secret manager.

PORT=3000
NODE_ENV=development

# --- Capa relacional PostgreSQL (obligatoria para el ORM) -------------------
# Puerto 5433 = expuesto por el contenedor redesa-postgres (5433:5432).
DB_HOST=localhost
DB_PORT=5433
DB_USER=salud
DB_PASSWORD=salud_pass_dev
DB_NAME=salud

# --- Pool de conexiones -----------------------------------------------------
# El mínimo debe ser >= 2: el cerrojo de arranque ocupa una conexión durante toda
# la materialización del esquema y el trabajo necesita otra.
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Inyección del DDL en el arranque ---------------------------------------
# safe    = aplica el DDL aditivo e idempotente (por defecto)
# dry-run = calcula y registra el DDL sin ejecutarlo
# off     = no toca la base; la estructura la gestiona otro proceso
ORM_SCHEMA_SYNC=safe

# Compara las 1159 entidades contra information_schema al terminar el arranque.
ORM_VERIFY_FIDELITY=true

# --- Observabilidad del ORM -------------------------------------------------
# Logs SQL de MikroORM (true | false). Muy ruidoso: solo depuración local.
MIKRO_ORM_DEBUG=false

# Umbral en ms por encima del cual una consulta se registra como advertencia.
ORM_SLOW_QUERY_MS=200

# --- Logging (pino, todas las capas) ----------------------------------------
# Nivel global: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info
# Salida legible con pino-pretty (requiere `yarn add -D pino-pretty`). JSON si false.
LOG_PRETTY=false

# --- Stores especializados (fuera del ORM: outbox + workers) ----------------
# Aún no consumidos por el backend; documentados para completar el contrato de env.
MONGODB_URI=mongodb://localhost:27018/salud_document_store

REDIS_HOST=localhost
REDIS_PORT=6380

OPENSEARCH_NODE=http://localhost:9201

MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=redesa_admin
MINIO_SECRET_KEY=redesa_secret_key
MINIO_BUCKET=redesa-health-files

# =============================================================================
# Infra local (docker-compose.yml) — SOLO afecta a los contenedores de dev.
# Postgres se siembra con DB_USER/DB_PASSWORD/DB_NAME de arriba: una sola fuente
# de verdad, así la app y el contenedor comparten credenciales.
# =============================================================================

# Prefijo del proyecto para nombres de contenedores/volúmenes/red (evita
# colisiones si corres varios stacks en la misma máquina).
COMPOSE_PROJECT_NAME=mantra-redesa

# Nombre de la base Mongo que crea el init (debe coincidir con MONGODB_URI).
MONGO_DB=salud_document_store

# --- Puertos publicados en el host (cambia si alguno ya está ocupado) --------
# DB_PORT y REDIS_PORT ya están definidos arriba y también los usa el compose.
MONGO_PORT=27018
OPENSEARCH_PORT=9201
OPENSEARCH_MONITOR_PORT=9601
MINIO_CONSOLE_PORT=9003

# --- Origen del DDL de arranque (SQL/ y NoSQL/) ------------------------------
# Rutas relativas al docker-compose.yml. El esquema vive dentro del repo en
# database/ (toolkit + vault + .puml + salida generada). En Windows funciona
# igual con barras normales.
SQL_INIT_DIR=./database/SQL
NOSQL_INIT_DIR=./database/NoSQL
