# =========================================================================
# Mantra Core Technologies · REDESA Health Ecosystem
# Plantilla de entorno — copiar a .env y ajustar. Valores de desarrollo.
# No poner secretos de producción acá (en prod: secret manager).
# Los puertos coinciden con los que expone docker-compose.yml.
# Las rutas del esquema (database/SQL, database/NoSQL) están FIJAS en el
# compose, integradas al repo: no se configuran por env.
# =========================================================================
PORT=3000
NODE_ENV=development

# --- SQL Relacional + TimescaleDB + pgvector (puerto expuesto 5433) ----------
# La app se conecta con DB_*; el contenedor Postgres se siembra con POSTGRES_*.
# Deben tener los MISMOS valores o la app no conectará.
DB_HOST=localhost
DB_PORT=5433
DB_USER=mantra
DB_PASSWORD=changeme_dev
DB_NAME=mantra_redesa_health

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=mantra
POSTGRES_PASSWORD=changeme_dev
POSTGRES_DB=mantra_redesa_health

# --- Mongo Document Store (puerto expuesto 27018) ----------------------------
# MONGO_DB debe coincidir con la base de MONGODB_URI.
MONGODB_URI=mongodb://localhost:27018/mantra_redesa_health_document_store
MONGO_DB=mantra_redesa_health_document_store

# --- Redis Runtime (puerto expuesto 6380) ------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380

# --- OpenSearch Search Platform (puerto expuesto 9201) -----------------------
OPENSEARCH_NODE=http://localhost:9201

# --- MinIO Object Storage (puerto expuesto 9002 API / 9003 consola) ----------
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=mantra
MINIO_SECRET_KEY=changeme_dev
MINIO_BUCKET=mantra-redesa-health-files

# --- Observabilidad del ORM --------------------------------------------------
MIKRO_ORM_DEBUG=false

# --- Materialización del esquema ---------------------------------------------
# off | dry-run | safe (el default del código es 'safe').
#
# DEBE quedar en 'off'. Con 'safe' la aplicación aplica DDL aditivo por sí sola al
# arrancar, es decir crea en Postgres tablas y columnas que `SQL/` no declara — la
# dirección de cambio prohibida por el protocolo de 4 capas
# (.puml -> SQL/ -> BD -> ORM). Así fue como llegaron a la base cuatro tablas que
# el modelo canónico no conocía.
#
# Para auditar deriva usá 'dry-run': calcula y loguea el DDL sin ejecutarlo, y sí
# corre el chequeo de fidelidad. Ojo: con 'off' el chequeo de fidelidad NO corre.
ORM_SCHEMA_SYNC=off
ORM_VERIFY_FIDELITY=true

# Autenticación (JWT). En producción JWT_SECRET es obligatorio (>=32) y no puede ser el default.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
ACCOUNT_LOCK_THRESHOLD=5

# Cifrado del secreto TOTP de MFA (AES-256-GCM). Obligatorio en producción.
MFA_ENCRYPTION_KEY=dev-only-mfa-key-change-me

# Firma de webhooks (entrantes y salientes). Obligatorio en producción.
WEBHOOK_SIGNING_KEY=dev-only-insecure-webhook-key-change-me

# Firma de las URL de descarga de archivos clínicos. Obligatorio en producción:
# con el valor de desarrollo, que es público, se puede forjar una URL de descarga
# para cualquier archivo.
DOWNLOAD_URL_SECRET=redesa-dev-download-secret

# Almacenamiento de archivos subidos por multipart (POST /common/files/upload).
# El adaptador `local` escribe en disco, direccionando por SHA-256 del contenido;
# un futuro adaptador S3 se selecciona aquí sin tocar el código que sube.
FILE_STORAGE_ADAPTER=local
FILE_STORAGE_LOCAL_DIR=./storage/uploads
FILE_STORAGE_MAX_SIZE_BYTES=10485760

# Aislamiento por tenant (RLS). RLS_ENFORCE=true hace que el interceptor fije
# app.current_tenant_id por request (transacción por petición). Para que las
# políticas RLS se apliquen, la app debe conectarse con un rol SIN bypassrls:
# definir DB_APP_USER/DB_APP_PASSWORD (p. ej. mantra_app) y ORM_SCHEMA_SYNC=off.
# El rol propietario (DB_USER) se reserva para migraciones/DDL/seed.
RLS_ENFORCE=false
# DB_APP_USER=mantra_app
# DB_APP_PASSWORD=

# Rate limiting: RATE_LIMIT_DISABLED=true solo en pruebas (mismo IP, muchas peticiones).
# RATE_LIMIT_DISABLED=false

# --- Trazas distribuidas (OpenTelemetry -> OTLP -> Jaeger) -------------------
# Ver `docs/observability/README.md`. Levantar Jaeger local: `yarn jaeger:up`.
#
# Apagado por defecto: activarlo abre conexiones salientes desde los 21 procesos
# (API + 20 workers), y eso debe ser una decisión explícita.
OTEL_ENABLED=false

# `service.name` se DERIVA del entrypoint en ejecución (`dist/src/main.js` ->
# redesa-api; `dist/src/worker-messaging.js` -> redesa-worker-messaging), así que
# normalmente no hace falta declararlo. Definirlo aquí lo fijaría para TODOS los
# procesos, incluidos los 20 workers: dejar vacío salvo que se sepa lo que se hace.
# OTEL_SERVICE_NAME=
OTEL_SERVICE_NAMESPACE=redesa
# Vacío = se toma de `npm_package_version`, o `unknown` fuera de un script de yarn.
OTEL_SERVICE_VERSION=
# Vacío = se toma de NODE_ENV.
OTEL_DEPLOYMENT_ENVIRONMENT=

# Único protocolo soportado: es el exportador instalado (`exporter-trace-otlp-proto`).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Esta variable la usan los procesos que corren FUERA de Docker
# (`yarn start:dev`, `yarn start:worker:*:dev`), que alcanzan Jaeger por el
# puerto publicado en 127.0.0.1.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Los contenedores de `docker-compose.yml` usan ESTA otra, porque dentro de la
# red de Docker `localhost` es el propio contenedor y no Jaeger. Son dos
# variables distintas justamente para poder tener ambos modos a la vez sin
# editar el `.env` cada vez que se cambia de uno a otro.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT_DOCKER=http://jaeger:4318/v1/traces
OTEL_EXPORT_TIMEOUT_MS=10000

# Muestreo basado en el padre: respeta la decisión del servicio aguas arriba, de
# modo que una traza que cruza worker -> API no queda partida por la mitad.
# Ratios orientativos: desarrollo 1.0, staging 0.25-1.0, producción 0.05-0.20.
# Ver `docs/observability/README.md` (muestreo) antes de bajarlo en producción.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

OTEL_PROPAGATORS=tracecontext,baggage
# Diagnóstico interno del SDK. NONE|ERROR|WARN|INFO|DEBUG|VERBOSE.
OTEL_DIAG_LOG_LEVEL=ERROR
# Cabecera `x-trace-id` en las respuestas HTTP: es el identificador que un
# usuario entrega a soporte para localizar su traza.
OTEL_TRACE_RESPONSE_HEADER=true

# Puertos publicados por `docker-compose.jaeger.yml` (solo en 127.0.0.1).
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318
JAEGER_OTLP_GRPC_PORT=4317

# --- Workers asíncronos (20 procesos separados, uno por dominio — ver
# `PLAN-CORRECCION-WORKERS-2026-07-28.md`. `yarn start:worker:<dominio>:dev`,
# p. ej. `yarn start:worker:messaging:dev`) --------------------------------
# URL interna de la API que consumen los workers como usuario SYSTEM autenticado.
WORKER_API_BASE_URL=http://127.0.0.1:3000
WORKER_HTTP_TIMEOUT_MS=30000
# Lista separada por comas. Vacía = no drenar colas de mensajes configurables.
MESSAGING_QUEUE_CODES=

# Umbral de compresión de chunks de time_series (12 series, automático).
TS_COMPRESSION_OLDER_THAN=7 days
# Ventana (horas) que se rematerializa en cada tick de rollups de time_series.
TS_ROLLUP_REFRESH_WINDOW_HOURS=2
# Retención de time_series: OPT-IN por tabla, vacía por defecto — drop_chunks
# borra datos sin vuelta atrás y cada serie tiene su propia política de
# cumplimiento. Formato: "tabla=intervalo,tabla2=intervalo2".
TS_RETENTION_POLICIES=

# Emulador standalone de proveedores externos (mensajería, borrado
# cross-store, embeddings) — proyecto independiente en `mock-provider-server/`,
# ver su README. Configurado por DEFECTO: si se deja vacía, cada worker cae
# al adapter que falla visible ("PROVIDER_NOT_CONFIGURED") en vez de fingir
# éxito contra un proveedor real inexistente.
MOCK_PROVIDER_BASE_URL=http://127.0.0.1:4100
# Sólo si levantaste mock-provider-server con MOCK_API_KEY configurada.
MOCK_PROVIDER_API_KEY=

# ATENCIÓN — verificación de identidad simulada.
# El emulador ACEPTA POR DEFECTO toda verificación: con la tasa de rechazo en 0,
# el documento de identidad de un paciente (IDA_CHECK_TYPE_IDENTITY_CARD) y la
# matrícula de un médico (IDA_CHECK_TYPE_MEDICAL_LICENSE) salen ambos ACCEPTED.
# Ningún registro civil ni colegio médico comprobó nada: el flujo se ejercita
# entero, pero la verificación es ficticia.
#
# Por eso los 20 workers ABORTAN el arranque si MOCK_PROVIDER_BASE_URL está
# configurada con NODE_ENV=production (ver `assertMockProviderNotInProduction`).
#
# Para probar el camino de RECHAZO, subir la tasa entre 0 y 1:
MOCK_IDENTITY_REJECTION_RATE=0
# Cuánto tarda la "autoridad" en resolver el veredicto (ms). Es lo que ejercita
# el bucle de espera del worker, que consulta hasta que deja de estar PENDING.
MOCK_IDENTITY_DELAY_MS=10000

# Proveedor REAL de envío de email (canal EMAIL de messaging) vía Gmail API,
# OAuth2 de cuenta normal (sin Workspace, sin delegación de dominio). Las 4
# deben estar presentes para que el worker de messaging use Gmail de verdad
# en vez del stub/mock — ver src/worker/google-email-client.service.ts y
# tools/google-oauth/get-refresh-token.mjs (script para obtener el
# GOOGLE_OAUTH_REFRESH_TOKEN con un consentimiento interactivo, una sola vez).
# Si ambos, mock y Google, están configurados a la vez, Google gana.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=
