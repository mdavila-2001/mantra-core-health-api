# =========================================================================
# Mantra Core Technologies · REDESA Health Ecosystem
# Plantilla de entorno — copiar a .env y ajustar. Valores de desarrollo.
# No poner secretos de producción acá (en prod: secret manager).
# Los puertos coinciden con los que expone docker-compose.yml.
# Las rutas del esquema (database/SQL, database/NoSQL) están FIJAS en el
# compose, integradas al repo: no se configuran por env.
# =========================================================================
PORT=3000
NODE_ENV=development

# --- SQL Relacional + TimescaleDB + pgvector (puerto expuesto 5433) ----------
# La app se conecta con DB_*; el contenedor Postgres se siembra con POSTGRES_*.
# Deben tener los MISMOS valores o la app no conectará.
DB_HOST=localhost
DB_PORT=5433
DB_USER=mantra
DB_PASSWORD=changeme_dev
DB_NAME=mantra_redesa_health

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=mantra
POSTGRES_PASSWORD=changeme_dev
POSTGRES_DB=mantra_redesa_health

# --- Mongo Document Store (puerto expuesto 27018) ----------------------------
# MONGO_DB debe coincidir con la base de MONGODB_URI.
MONGODB_URI=mongodb://localhost:27018/mantra_redesa_health_document_store
MONGO_DB=mantra_redesa_health_document_store

# --- Redis Runtime (puerto expuesto 6380) ------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380

# --- OpenSearch Search Platform (puerto expuesto 9201) -----------------------
OPENSEARCH_NODE=http://localhost:9201

# --- MinIO Object Storage (puerto expuesto 9002 API / 9003 consola) ----------
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=mantra
MINIO_SECRET_KEY=changeme_dev
MINIO_BUCKET=mantra-redesa-health-files

# --- Observabilidad del ORM --------------------------------------------------
MIKRO_ORM_DEBUG=false

# Autenticación (JWT). En producción JWT_SECRET es obligatorio (>=32) y no puede ser el default.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
ACCOUNT_LOCK_THRESHOLD=5

# Cifrado del secreto TOTP de MFA (AES-256-GCM). Obligatorio en producción.
MFA_ENCRYPTION_KEY=dev-only-mfa-key-change-me

# Aislamiento por tenant (RLS). RLS_ENFORCE=true hace que el interceptor fije
# app.current_tenant_id por request (transacción por petición). Para que las
# políticas RLS se apliquen, la app debe conectarse con un rol SIN bypassrls:
# definir DB_APP_USER/DB_APP_PASSWORD (p. ej. mantra_app) y ORM_SCHEMA_SYNC=off.
# El rol propietario (DB_USER) se reserva para migraciones/DDL/seed.
RLS_ENFORCE=false
# DB_APP_USER=mantra_app
# DB_APP_PASSWORD=

# Rate limiting: RATE_LIMIT_DISABLED=true solo en pruebas (mismo IP, muchas peticiones).
# RATE_LIMIT_DISABLED=false

# --- Workers asíncronos (20 procesos separados, uno por dominio — ver
# `PLAN-CORRECCION-WORKERS-2026-07-28.md`. `yarn start:worker:<dominio>:dev`,
# p. ej. `yarn start:worker:messaging:dev`) --------------------------------
# URL interna de la API que consumen los workers como usuario SYSTEM autenticado.
WORKER_API_BASE_URL=http://127.0.0.1:3000
WORKER_HTTP_TIMEOUT_MS=30000
# Lista separada por comas. Vacía = no drenar colas de mensajes configurables.
MESSAGING_QUEUE_CODES=

# Umbral de compresión de chunks de time_series (12 series, automático).
TS_COMPRESSION_OLDER_THAN=7 days
# Ventana (horas) que se rematerializa en cada tick de rollups de time_series.
TS_ROLLUP_REFRESH_WINDOW_HOURS=2
# Retención de time_series: OPT-IN por tabla, vacía por defecto — drop_chunks
# borra datos sin vuelta atrás y cada serie tiene su propia política de
# cumplimiento. Formato: "tabla=intervalo,tabla2=intervalo2".
TS_RETENTION_POLICIES=

# Emulador standalone de proveedores externos (mensajería, borrado
# cross-store, embeddings) — proyecto independiente en `mock-provider-server/`,
# ver su README. Configurado por DEFECTO: si se deja vacía, cada worker cae
# al adapter que falla visible ("PROVIDER_NOT_CONFIGURED") en vez de fingir
# éxito contra un proveedor real inexistente.
MOCK_PROVIDER_BASE_URL=http://127.0.0.1:4100
# Sólo si levantaste mock-provider-server con MOCK_API_KEY configurada.
MOCK_PROVIDER_API_KEY=

# Proveedor REAL de envío de email (canal EMAIL de messaging) vía Gmail API,
# OAuth2 de cuenta normal (sin Workspace, sin delegación de dominio). Las 4
# deben estar presentes para que el worker de messaging use Gmail de verdad
# en vez del stub/mock — ver src/worker/google-email-client.service.ts y
# tools/google-oauth/get-refresh-token.mjs (script para obtener el
# GOOGLE_OAUTH_REFRESH_TOKEN con un consentimiento interactivo, una sola vez).
# Si ambos, mock y Google, están configurados a la vez, Google gana.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=
