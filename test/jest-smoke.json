{
  "rootDir": "..",
  "testMatch": ["<rootDir>/test/smoke/**/*.int-spec.ts"],
  "moduleFileExtensions": ["js", "json", "ts"],
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "useESM": true, "tsconfig": "<rootDir>/test/tsconfig.integration.json" }]
  },
  "testEnvironment": "node",
  "testTimeout": 180000,
  "maxWorkers": 1
}
