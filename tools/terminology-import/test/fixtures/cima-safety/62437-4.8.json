top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.3pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Diarrea y n&#225;useas.</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.25pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">*Poco frecuentes</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.3pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">V&#243;mitos.</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td colspan=\"2\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:460.55pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Datos de post-comercializaci&#243;n</span></em></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.25pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Muy raras</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.3pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Colitis asociada con el uso de antibi&#243;ticos (incluyendo colitits pseudomembranosa y colitits hemorr&#225;gica, ver secci&#243;n 4.4).</span></p>\r\n\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n          <p style=\"margin:0pt; text-align:justify\"><strong><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Para formulaciones orales solo:</span></em></strong></p>\r\n\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Lengua vellosa negra.</span></p>\r\n\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n          <p style=\"margin:0pt; text-align:justify\"><strong><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Para comprimidos y suspensiones orales solo:</span></em></strong></p>\r\n\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Alteraci&#243;n superficial en la coloraci&#243;n de los dientes.</span> <span style=\"font-family:Times New Roman; font-size:7.33pt; vertical-align:super\">#</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.25pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">No conocida</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.3pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">S&#237;ndrome de enterocolitis inducido por f&#225;rmaco.</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td colspan=\"2\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:460.55pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><strong><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Trastornos hepatobiliares</span></u></strong></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.25pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Muy raras</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.3pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Hepatitis e ictericia colest&#225;sica. Aumento moderado de AST y/o ALT.</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td colspan=\"2\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:460.55pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><strong><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Trastornos de la piel y del tejido subcut&#225;neo</span></u></strong></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td colspan=\"2\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:460.55pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Datos de Ensayos Cl&#237;nicos</span></em></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.25pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">*Frecuentes</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.3pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Erupci&#243;n cut&#225;nea.</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.25pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">*Poco frecuentes</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.3pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Urticaria y prurito.</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td colspan=\"2\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:460.55pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Datos de post-comercializaci&#243;n.</span></em></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.25pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Muy raras</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.3pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Reacciones de la piel como eritema multiforme, s&#237;ndrome de Stevens-Johnson, necr&#243;lisis epid&#233;rmica t&#243;xica, dermatitis exfoliativa bullosa, pustulosis exantem&#225;tica generalizada aguda (PEAG) (ver secci&#243;n 4.4) y reacci&#243;n medicamentosa con eosinofilia y s&#237;ntomas sist&#233;micos (DRESS).</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.25pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">No conocida</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.3pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Enfermedad por IgA lineal.</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td colspan=\"2\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:460.55pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><strong><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Trastornos renales y urinarios</span></u></strong></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.25pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Muy raras</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.3pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Nefritis intersticial.</span></p>\r\n\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Cristaluria (ver secciones 4.4 y 4.9 Sobredosis).</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.25pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">No conocida</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.3pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Cristaluria (incluyendo lesi&#243;n renal aguda).</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td colspan=\"2\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:460.55pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><strong><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Trastornos card&#237;acos</span></u></strong></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.25pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">No conocida</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:230.3pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">S&#237;ndrome de Kounis.</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td colspan=\"2\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:460.55pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">* La incidencia de estas reacciones adversas derivaba de los ensayos cl&#237;nicos que implicaron un total de aproximadamente 6.000 pacientes adultos y pedi&#225;tricos que tomaron amoxicilina.</span></p>\r\n\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:7.33pt; vertical-align:super\">#</span> <strong><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Para comprimidos y suspensiones orales solo:</span></em></strong> <span style=\"font-family:Times New Roman; font-size:11pt\">Se ha notificado alteraci&#243;n superficial en la coloraci&#243;n de los dientes en ni&#241;os. Una correcta higiene bucal puede ayudar a prevenir esta alteraci&#243;n ya que normalmente se puede eliminar con el cepillado.</span></p>\r\n        </td>\r\n      </tr><!--[if !supportMisalignedColumns]><tr style=\"height:0pt\">\r\n                                        <td style=\"width:230.25pt; border:none\">\r\n                                        </td>\r\n                                        <td style=\"width:230.3pt; border:none\">\r\n                                        </td>\r\n                                </tr><![endif]-->\r\n    </table>\r\n\r\n    <p style=\"margin:0pt 0pt 6pt; text-indent:14.2pt; text-align:justify; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n    <p style=\"margin:0pt 0pt 6pt; text-align:justify; line-height:150%; widows:0; orphans:0; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Notificaci&#243;n de sospechas de reacciones adversas</span></u></p>\r\n\r\n    <p style=\"margin:0pt 0pt 6pt; text-align:justify; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Es importante notificar sospechas de reacciones adversas al medicamento tras su autorizaci&#243;n. Ello permite una supervisi&#243;n continuada de la relaci&#243;n beneficio/riesgo del medicamento. Se invita a los profesionales sanitarios a notificar las sospechas de reacciones adversas a trav&#233;s del sistema nacional de notificaci&#243;n incluido en el Sistema Espa&#241;ol de Farmacovigilancia de Medicamentos de Uso Humano:</span> <a href=\"http://www.notificaRAM.es\"><u><span style=\"font-family:Times New Roman; font-size:11pt; color:#0563c1\">www.notificaRAM.es</span></u></a><span style=\"font-family:Times New Roman; font-size:11pt\">.</span></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n  </div>",
   "orden": 16
  }
