[Term]
id: NCIT:C12218
name: Chemotherapy Regimen or Agent Combination
def: "A combination of multiple drugs used in standard or clinical trial treatments. The order, dosage or dosing interval of the individual ingredients may not be specified." [] {NCIT:P378="NCI"}
