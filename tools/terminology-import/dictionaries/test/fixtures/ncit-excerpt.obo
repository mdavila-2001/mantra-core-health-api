[Typedef]
id: NCIT:R124
name: Chemical_Or_Drug_Has_Mechanism_Of_Action
def: "A role used to imply the interaction or binding of an active ingredient of a drug/chemical agent at the molecular level with its target. When possible, the role value should reflect the direct alteration of function of a target molecule or complex. The domain and range for this role are 'Drug, Food, Chemical or Biomedical Material' and 'Biological Process', respectively." [] {NCIT:P378="NCI"}
synonym: "Chemical_Or_Drug_Has_Mechanism_Of_Action" EXACT [] {NCIT:P383="PT", NCIT:P384="NCI"}
property_value: NCIT:NHC0 "R124" xsd:string
property_value: NCIT:P106 "Conceptual Entity" xsd:string
property_value: NCIT:P107 "Has Mechanism Of Action" xsd:string
property_value: NCIT:P108 "Chemical_Or_Drug_Has_Mechanism_Of_Action" xsd:string
domain: NCIT:C1908 ! Drug, Food, Chemical or Biomedical Material
range: NCIT:C17828 ! Biological Process

[Typedef]
id: NCIT:R125
name: Chemical_Or_Drug_Has_Physiologic_Effect
def: "A role used to describe the primary detectable alterations of subcellular, cellular, tissue, or organ functions that directly result from alteration of function of a target biological molecule or complex caused by interaction of a therapeutic agent with a target molecule or complex. The domain and range for this role are 'Drug, Food, Chemical or Biomedical Material' and 'Biological Process', respectively." [] {NCIT:P378="NCI"}
synonym: "Chemical_Or_Drug_Has_Physiologic_Effect" EXACT [] {NCIT:P383="PT", NCIT:P384="NCI"}
property_value: NCIT:NHC0 "R125" xsd:string
property_value: NCIT:P106 "Conceptual Entity" xsd:string
property_value: NCIT:P107 "Has Physiologic Effect" xsd:string
property_value: NCIT:P108 "Chemical_Or_Drug_Has_Physiologic_Effect" xsd:string
domain: NCIT:C1908 ! Drug, Food, Chemical or Biomedical Material
range: NCIT:C17828 ! Biological Process

[Typedef]
id: NCIT:R27
name: Conceptual_Part_Of
def: "A role used to indicate that a conceptual entity is a sub-entity of another conceptual entity. Both the domain and the range for this role are 'Conceptual Entity'." [] {NCIT:P378="NCI"}
synonym: "Conceptual_Part_Of" EXACT [] {NCIT:P383="PT", NCIT:P384="NCI"}
