[
 {
  "seccion": "5.1",
  "titulo": "Propiedades farmacodinámicas",
  "contenido": "<div>\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Grupo farmacoterap&#233;utico: penicilinas de amplio espectro; c&#243;digo ATC: J01CA04.&#160;&#160;</span></p>\r\n  </div>",
  "orden": 2
 },
 {
  "seccion": "5.1.1",
  "titulo": "Mecanismo de acción",
  "contenido": "<div>\r\n    <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">La amoxicilina es una penicilina semisint&#233;tica (antibi&#243;tico beta-lact&#225;mico) que inhibe una o m&#225;s enzimas (a menudo conocidas como prote&#237;nas de uni&#243;n a las penicilinas, PBPs</span> <span style=\"font-family:Times New Roman; font-size:11pt\">por sus siglas en ingl&#233;s) en la ruta biosint&#233;tica del peptidoglicano bacteriano, que es un componente estructural integral de la pared celular bacteriana. La inhibici&#243;n de la s&#237;ntesis del peptidoglicano produce un debilitamiento de la pared celular, que normalmente va seguido por lisis y muerte celular.</span></p>\r\n\r\n    <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">La amoxicilina es sensible a la degradaci&#243;n por las beta-lactamasas producidas por bacterias resistentes y por tanto el espectro de actividad de la amoxicilina sola no incluye microorganismos productores de estas enzimas.</span></p>\r\n\r\n    <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n    <p style=\"margin:0pt; page-break-after:avoid; line-height:115%; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Relaci&#243;n farmacocin&#233;tica/farmacodin&#225;mica</span></u></p>\r\n\r\n    <p style=\"margin:0pt; page-break-after:avoid; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n    <p style=\"margin:0pt; page-break-after:avoid; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">El tiempo que las concentraciones s&#233;ricas se mantienen por encima de la concentraci&#243;n m&#237;nima inhibitoria</span> <span style=\"font-family:Times New Roman; font-size:11pt\">(t &#62;</span> <span style=\"font-family:Times New Roman; font-size:11pt\">CMI</span><span style=\"font-family:Times New Roman; font-size:11pt\">) se considera el mayor determinante de la eficacia de amoxicilina.</span></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Mecanismos de resistencia</span></u></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Los mecanismos principales de resistencia a amoxicilina son:</span></p>\r\n\r\n    <ul type=\"disc\" style=\"margin:0pt; padding-left:0pt\">\r\n      <li style=\"margin:0pt 0pt 0pt 28.35pt; text-indent:0pt; line-height:13pt; font-family:serif; font-size:11pt; list-style-position:inside\"><span style=\"font-family:Times New Roman; font-size:11pt\">Inactivaci&#243;n por las beta-lactamasas bacterianas.</span></li>\r\n\r\n      <li style=\"margin:0pt 0pt 0pt 28.35pt; text-indent:0pt; line-height:13pt; font-family:serif; font-size:11pt; list-style-position:inside\"><span style=\"font-family:Times New Roman; font-size:11pt\">Alteraci&#243;n de las prote&#237;nas de uni&#243;n a la penicilina (PBPs, por sus siglas en ingl&#233;s) que reducen la afinidad del agente antibacteriano por la diana.</span></li>\r\n    </ul>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">La impermeabilidad de la bacteria o los mecanismos de bombas de expulsi&#243;n pueden causar o contribuir a la resistencia bacteriana, especialmente en bacterias Gram-negativas.</span></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n    <p style=\"margin:0pt; page-break-after:avoid; line-height:115%; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Puntos de corte</span></u></p>\r\n\r\n    <p style=\"margin:0pt; page-break-after:avoid; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n    <p style=\"margin:0pt; page-break-after:avoid; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Los puntos de corte de CMI (concentraci&#243;n m&#237;nima inhibitoria) para los an&#225;lisis de susceptibilidad de amoxicilina son los establecidos por el</span> <em><span style=\"font-family:Times New Roman; font-size:11pt;\">European Committee on Antimicrobial Susceptibility Testing</span></em> <span style=\"font-family:Times New Roman; font-size:11pt\">(EUCAST) y pueden consultarse aqu&#237;:</span> <a href=\"https://www.ema.europa.eu/documents/other/minimum-inhibitory-concentration-mic-breakpoints_en.xlsx\"><u><span style=\"font-family:Times New Roman; font-size:11pt; color:#0000ff\">https://www.ema.europa.eu/documents/other/minimum-inhibitory-concentration-mic-breakpoints_en.xlsx</span></u></a></p>\r\n\r\n    <p style=\"margin:0pt; page-break-after:avoid; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n    <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">La prevalencia de la resistencia puede variar geogr&#225;ficamente y con el tiempo para especies seleccionadas, y es deseable informaci&#243;n local sobre resistencia, sobre todo en el tratamiento de infecciones graves. Si es necesario, se debe buscar consejo experto cuando la prevalencia local de la resistencia es tal que la utilidad del agente, al menos en algunos tipos de infecciones, es cuestionable.</span></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n    <table cellspacing=\"0\" cellpadding=\"0\" style=\"border-collapse:collapse; margin-left:0pt\">\r\n      <tr style=\"height:18.05pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><strong><span style=\"font-family:Times New Roman; font-size:11pt;\">Sensibilidad</span></strong> <strong><em><span style=\"font-family:Times New Roman; font-size:11pt;\">in vitro</span></em></strong> <strong><span style=\"font-family:Times New Roman; font-size:11pt;\">de microorganismos a amoxicilina</span></strong></p>\r\n\r\n          <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><strong><span style=\"font-family:Times New Roman; font-size:11pt;\">&#xa0;</span></strong></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:18.05pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><strong><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Especies frecuentemente sensibles</span></u></strong></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:20.8pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Aerobios Gram-positivos:</span></u></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Enterococcus faecalis</span></em></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Estreptococos</span> <span style=\"font-family:Times New Roman; font-size:11pt\">beta-hemol&#237;ticos (Grupos A, B, C y G)</span></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Listeria monocytogenes</span></em></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:28.85pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><strong><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Especies para las cuales la resistencia adquirida puede ser un problema</span></u></strong></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:26.5pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Aerobios</span></u> <u><span style=\"font-family:Times New Roman; font-size:11pt;\">Gram-negativos:</span></u></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Escherichia coli</span></em></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Haemophilus influenzae</span></em></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Helicobacter pylori</span></em></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Proteus mirabilis</span></em></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Salmonella</span></em> <em><span style=\"font-family:Times New Roman; font-size:11pt;\">typhi</span></em></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Salmonella</span></em> <em><span style=\"font-family:Times New Roman; font-size:11pt;\">paratyphi</span></em></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Pasteurella multocida</span></em></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:85.55pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Aerobios</span></u> <u><span style=\"font-family:Times New Roman; font-size:11pt;\">Gram-positivos:</span></u></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Staphylococcus</span></em> <span style=\"font-family:Times New Roman; font-size:11pt\">coagulasa negativos&#160;</span></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Staphylococcus aureus</span></em><em><span style=\"font-family:Times New Roman; font-size:7.33pt; vertical-align:super\">&#163;</span></em></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Streptococcus pneumoniae</span></em></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Estreptococos</span> <span style=\"font-family:Times New Roman; font-size:11pt\">grupo Viridans&#160;</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:42pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Anaerobios Gram-positivos:</span></u></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Clostridium</span></em> <span style=\"font-family:Times New Roman; font-size:11pt\">spp.</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:22pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Anaerobios Gram-negativos:</span></u></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Fusobacterium</span></em> <span style=\"font-family:Times New Roman; font-size:11pt\">spp.</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:22pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Otros:</span></u></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Borrelia burgdorferi</span></em></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:21.55pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><strong><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Microorganismos intr&#237;nsecamente resistentes</span></u></strong><span style=\"font-family:Times New Roman; font-size:7.33pt; vertical-align:super\">&#8224;</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:35.95pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Aerobios Gram-positivos:</span></u></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Enterococcus faecium</span></em><span style=\"font-family:Times New Roman; font-size:11pt\">&#8224;</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:35.95pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><strong><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Sensibilidad</span></u></strong> <strong><em><u><span style=\"font-family:Times New Roman; font-size:11pt;\">in vitro</span></u></em></strong> <strong><u><span style=\"font-family:Times New Roman; font-size:11pt;\">de microorganismos a amoxicilina</span></u></strong></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:105.8pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Aerobios Gram-negativos:</span></u></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Acinetobacter</span></em> <span style=\"font-family:Times New Roman; font-size:11pt\">spp.</span></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Enterobacter</span></em> <span style=\"font-family:Times New Roman; font-size:11pt\">spp.</span></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Klebsiella</span></em> <span style=\"font-family:Times New Roman; font-size:11pt\">spp.</span></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Pseudomonas</span></em> <span style=\"font-family:Times New Roman; font-size:11pt\">spp.</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Anerobios Gram-negativos:</span></u></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Bacteroides</span></em> <span style=\"font-family:Times New Roman; font-size:11pt\">spp.</span> <span style=\"font-family:Times New Roman; font-size:11pt\">(muchas cepas de</span> <em><span style=\"font-family:Times New Roman; font-size:11pt;\">Bacteroides fragilis</span></em> <span style=\"font-family:Times New Roman; font-size:11pt\">son resistentes).</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:38.75pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Otros:</span></u></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Chlamydia</span></em> <span style=\"font-family:Times New Roman; font-size:11pt\">spp.</span></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Mycoplasma</span></em> <span style=\"font-family:Times New Roman; font-size:11pt\">spp.</span></p>\r\n\r\n          <p style=\"margin:0pt; line-height:150%; font-size:11pt\"><em><span style=\"font-family:Times New Roman; font-size:11pt;\">Legionella</span></em> <span style=\"font-family:Times New Roman; font-size:11pt\">spp.</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:39.25pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:432pt\">\r\n          <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:7.33pt; vertical-align:super\">&#8224;</span><span style=\"font-family:Times New Roman; font-size:11pt\">Sensibilidad natural intermedia en ausencia de mecanismo de resistencia adquirido.</span></p>\r\n\r\n          <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:7.33pt; vertical-align:super\">&#163;</span><span style=\"font-family:Times New Roman; font-size:11pt\">Casi todos los</span> <em><span style=\"font-family:Times New Roman; font-size:11pt;\">S. aureus</span></em> <span style=\"font-family:Times New Roman; font-size:11pt\">son resistentes a amoxicilina debido a la producci&#243;n de penicilinasa. Adem&#225;s, todas las cepas resistentes a meticilina son resistentes a amoxicilina.</span></p>\r\n        </td>\r\n      </tr>\r\n    </table>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n  </div>",
  "orden": 3
 }
]