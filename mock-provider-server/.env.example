# Puerto en el que escucha el emulador.
PORT=4100

# Clave que deben mandar los clientes en el header `X-Api-Key`. Vacía por
# defecto: sin ella el emulador no exige autenticación (cómodo para levantarlo
# suelto en local). En docker-compose se fija a un valor de desarrollo.
MOCK_API_KEY=

# Probabilidad (0-1) de que /notifications/send falle, para poder ejercitar el
# camino de reintento/backoff del worker real sin depender del azar puro.
NOTIFICATIONS_FAILURE_RATE=0.1

# Probabilidad (0-1) de que /deletions/execute falle.
DELETIONS_FAILURE_RATE=0.05

# Latencia simulada (ms) que se añade a cada respuesta, para que el
# comportamiento se parezca más a un proveedor real que a una función local.
SIMULATED_LATENCY_MS=50
