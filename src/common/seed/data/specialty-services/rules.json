  "performer": {
    "_nota": "Patrones del descriptor que nombran a QUIEN presta el servicio. La captura (resto del descriptor) se recorta por los delimitadores y se busca EXACTA en `phrases`. Una captura que no está en la tabla queda en el reporte como «frase sin regla», sin relación.",
    "patterns": {
      "cups": [
        "\\bPOR ESPECIALISTA EN (.+)$",
        "\\bPOR (MEDICINA GENERAL|MEDICINA ESPECIALIZADA|OTRAS ESPECIALIDADES MEDICAS|ODONTOLOGIA GENERAL|ODONTOLOGIA ESPECIALIZADA|OTRAS ESPECIALIDADES EN ODONTOLOGIA|ODONTOLOGIA|HIGIENE ORAL|ENFERMERIA|NUTRICION Y DIETETICA|PSICOLOGIA|OTRAS ESPECIALIDADES DE PSICOLOGIA|FISIOTERAPIA|PSIQUIATRIA|TERAPIA OCUPACIONAL|TERAPIA RESPIRATORIA|FONIATRIA Y FONOAUDIOLOGIA|FONOAUDIOLOGIA|TRABAJO SOCIAL|OPTOMETRIA|TERAPIAS ALTERNATIVAS|EQUIPO INTERDISCIPLINARIO|AGENTE EDUCATIVO)\\b(.*)$"
      ],
      "fonasa": [
        "^(?:TELE)?CONSULTA MEDICA DE ESPECIALIDAD EN (.+)$",
        "^(?:TELE)?CONSULTA (MEDICINA GENERAL)$",
        "\\b(PSICOLOGO CLINICO)\\b",
        "\\bDE (CARDIOLOGO)\\b",
        "^(?:TELECONSULTA: )?ATENCION INTEGRAL DE (ENFERMERIA|NUTRICIONISTA|MATRONERIA)\\b",
        "\\bHONORARIO (?:DE )?(MATRONA)\\b",
        "^(?:TELEREHABILITACION: )?(?:EVALUACION|ATENCION) (KINESIOLOGICA)\\b",
        "^(?:TELEREHABILITACION: )?(?:ATENCION INTEGRAL DE|INTERVENCION(?: DE)?) (TERAPIA OCUPACIONAL)\\b",
        "\\bINTEGRAL DE (FONOAUDIOLOGO)\\b",
        "^ATENCION (ODONTOLOGICA) INTEGRAL\\b"
      ]
    },
    "trailingCut": [
      "\\s*\\(1RA CONSULTA\\)$",
      "\\s+Y CASO \\(PACIENTE\\)$",
      "\\s+(ADULTOS?|PEDIATRICOS?)$"
    ],
