      "code": "estudio_comparativo_previo",
      "name": "Estudio comparativo previo",
      "dataType": "text",
      "required": false
    },
    {
      "section": "Informe",
      "code": "malignidad",
      "name": "Malignidad",
      "dataType": "string",
      "required": false,
      "options": [
        "Benigno",
