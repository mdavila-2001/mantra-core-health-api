      "showWhen": { "field": "malignidad", "equals": "Maligno" }
    },
    {
      "section": "Informe",
      "code": "grado_histologico",
      "name": "Grado histológico",
      "dataType": "string",
      "required": false,
      "showWhen": { "field": "malignidad", "equals": "Maligno" }
    },
    {
      "section": "Informe",
