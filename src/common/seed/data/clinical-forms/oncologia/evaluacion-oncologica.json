  "provenance": {
    "sourceTitle": "Norma Técnica de Salud para la Gestión de la Historia Clínica — NT N.º 022-MINSA/DGSP-V.02, anamnesis, examen físico y notas de evolución",
    "organization": "Ministerio de Salud del Perú (MINSA)",
