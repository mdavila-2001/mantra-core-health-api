{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow.schema.json",
  "title": "Flujo del catálogo",
  "description": "Describe la FORMA de un artefacto. Las reglas de coherencia (ciclos, nodos sueltos, un HAPPY_PATH por llamada) las aplica domain/flow-catalog.ts.",
  "type": "object",
  "required": ["id", "version", "module", "title", "source", "actors", "frontRoutes", "root", "nodes", "openQuestions"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "version": { "const": 1 },
    "module": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["document", "section"],
      "additionalProperties": false,
      "properties": {
        "document": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 }
      }
    },
    "actors": { "type": "array", "items": { "type": "string" } },
    "frontRoutes": { "type": "array", "items": { "type": "string" } },
    "root": { "type": "string" },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "openQuestions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
    "node": {
      "type": "object",
      "required": ["id", "kind", "title", "actor", "sourceRef", "branches"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "kind": { "enum": ["SCREEN", "API_CALL", "DECISION", "OUTCOME"] },
        "title": { "type": "string", "minLength": 1 },
        "actor": { "type": "string" },
        "uiRoute": { "type": "string" },
        "endpoint": {
          "type": "object",
          "required": ["method", "path"],
          "additionalProperties": false,
          "properties": {
            "method": { "$ref": "#/$defs/method" },
            "path": { "type": "string", "pattern": "^/" }
          }
        },
        "gap": { "type": "string", "minLength": 1 },
        "effects": { "type": "array", "items": { "type": "string" } },
        "sourceRef": { "type": "string", "minLength": 1 },
        "branches": { "type": "array", "items": { "$ref": "#/$defs/branch" } }
      }
    },
    "branch": {
      "type": "object",
      "required": ["kind", "condition", "expected"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["HAPPY_PATH", "EDGE", "NEGATIVE"] },
        "condition": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 },
        "next": { "type": "string" },
        "loopsTo": { "type": "string" },
        "reason": { "type": "string" },
        "qaCase": {
          "type": "object",
          "required": ["method", "path", "expectedStatus", "observedOn"],
          "additionalProperties": false,
          "properties": {
            "method": { "$ref": "#/$defs/method" },
            "path": { "type": "string", "pattern": "^/[^{}]*$" },
            "expectedStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
            "body": {},
            "headers": { "type": "object", "additionalProperties": { "type": "string" } },
            "observedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      }
    }
  }
}
